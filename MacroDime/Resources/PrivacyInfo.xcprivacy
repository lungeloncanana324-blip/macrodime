<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    PrivacyInfo.xcprivacy
    MacroDime

    Apple requires this manifest for every app and third-party SDK since
    spring 2024. It answers two questions: what data leaves the device, and
    which "required reason" APIs the app touches.

    Data: none collected. MacroDime has no account, no analytics, no network
    calls at all. Body metrics, meals, prices and progress photos stay in the
    app's own SwiftData store. The photo library is read only when the user
    picks a progress photo, and the image is copied into that store.

    APIs: none. The catalogue seeder used UserDefaults to remember a version
    number; it now compares the stored catalogue by value, and no other code
    touches UserDefaults, file timestamps, disk space or boot time. If any
    code starts to use UserDefaults or @AppStorage, declare
    NSPrivacyAccessedAPICategoryUserDefaults with reason CA92.1 (information
    accessible only to the app itself). ios.yml fails the build until it is.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>
