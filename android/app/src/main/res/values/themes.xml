<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window theme only. Everything drawn is Compose (ui/theme/Theme.kt);
        this sets the colour shown before the first frame, and the launch screen
        Android 12 and later builds from it and the app icon.
    -->
    <style name="Theme.MacroDime" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
