<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 to 11. android:allowBackup="false" already switches backup off
    there; these rules say the same thing explicitly, so the answer does not
    depend on one attribute. Android 12 and later read data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
